# Local server
PAK_ENERGY_HOST=127.0.0.1
PAK_ENERGY_PORT=8765
PAK_ENERGY_OPEN_BROWSER=1

# Keep cache and temporary data on the D: workspace in development.
PAK_ENERGY_CACHE_DIR=cache/resources

# Optional Copernicus Marine setup. Never commit real credentials.
# Prefer a credentials file stored outside the repository on D:.
PAK_ENERGY_COPERNICUS_CREDENTIALS_FILE=
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=

# Comma-separated development frontend origins.
PAK_ENERGY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional no-key indicative FX feed used only for USD/PKR display conversion.
# The UI shows the provider and timestamp and falls back to a dated bundled rate.
PAK_ENERGY_FX_ENDPOINT=https://open.er-api.com/v6/latest/USD
